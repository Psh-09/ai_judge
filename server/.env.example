DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codecourt
JWT_SECRET=change-me-in-production
LLM_PROVIDER=fixture

# 배포 관련 (기본값은 로컬 개발 기준. ENVIRONMENT=production이면 JWT_SECRET 기본값 사용 시 기동 실패)
ENVIRONMENT=development
# 워커를 별도 프로세스로 못 띄우는 환경을 위한 폴백. 정석은 false(별도 worker 프로세스).
RUN_WORKER_IN_APP=false
# 프론트엔드 도메인. 콤마로 여러 개 지정 가능. 비어 있으면 CORS 미들웨어를 아예 걸지 않는다.
CORS_ALLOWED_ORIGINS=
